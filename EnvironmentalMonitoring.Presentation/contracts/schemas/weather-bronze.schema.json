{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weather-bronze.schema.json",
  "title": "Weather Bronze Data Contract",
  "description": "Contrato dos documentos meteorológicos armazenados na camada Bronze.",
  "type": "object",
  "required": [
    "metadata",
    "payload"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "contract_version",
        "source",
        "ingestion_datetime",
        "station"
      ],
      "properties": {
        "contract_version": {
          "type": "string",
          "const": "1.0"
        },
        "source": {
          "type": "object",
          "required": [
            "type",
            "provider"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "api",
                "operator",
                "file"
              ]
            },
            "provider": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "ingestion_datetime": {
          "type": "string",
          "format": "date-time"
        },
        "station": {
          "type": "object",
          "required": [
            "code",
            "name",
            "latitude",
            "longitude"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        }
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "datetime",
        "parameters"
      ],
      "properties": {
        "datetime": {
          "type": "string",
          "format": "date-time"
        },
        "parameters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/measurement"
          }
        }
      }
    }
  },
  "$defs": {
    "measurement": {
      "type": "object",
      "required": [
        "parameter_code",
        "source_code",
        "name",
        "value",
        "unit"
      ],
      "properties": {
        "parameter_code": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "source_code": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        }
      }
    }
  }
}