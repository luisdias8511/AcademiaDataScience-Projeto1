# Para instalar a biblioteca cryptography, execute: pip install cryptography
from cryptography.fernet import Fernet

# Gere e salve esta chave em um lugar seguro
chave = Fernet.generate_key()
print(chave.decode())


f = Fernet(chave)
token = f.encrypt(b"TASHQxcxqNgqwqSe2VEXJXX8gXziRgWK")
print(token.decode())